# Ingestion Config
INGESTION_FILE=sample_data_1000000_rows.csv
BATCH_SIZE=25000
CORE_THREADS=8
MAX_THREADS=10
PROCESSOR_THREADS=7
QUEUE_CAPACITY=25
SKIP_HEADER=true
INGESTION_STRATEGY=DATABASE_BATCH
SKIP_ANALYTICS_UPDATE=false

# Database Credentials [MySQL]
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE_NAME=dev_db
DB_USERNAME=db_user
DB_PASSWORD=db_password